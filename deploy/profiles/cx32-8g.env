# echo memory profile — Hetzner CX32 (8 GB, 4 vCPU). FALLBACK.
#
# One-command downsize from the 16 GB default:
#
#     docker compose --env-file deploy/profiles/cx32-8g.env up -d
#
# No code change — a pure file swap. See docs/RUNBOOK.md →
# "Memory profiles (16↔8 GB switch)".

# ── Per-container memory ceilings ──────────────────────────────────────
# Σ ≈ 5.75 GB, leaving ~2.25 GB host headroom on an 8 GB box.
POSTGRES_MEM_LIMIT=1024m
REDIS_MEM_LIMIT=512m
API_MEM_LIMIT=512m
WORKER_MEM_LIMIT=768m
OSINT_PY_MEM_LIMIT=3072m

# ── Per-container CPU ceilings (max, not reservation) ──────────────────
POSTGRES_CPUS=1
REDIS_CPUS=1
API_CPUS=1
WORKER_CPUS=2
OSINT_PY_CPUS=2

# ── Heavy-provider concurrency — tighter on the small box ──────────────
# One heavy run at a time; mailcat's Chromium is too heavy for 8 GB.
GLOBAL_HEAVY_CONCURRENCY=1
MAIGRET_MAX_CONCURRENCY=1
MAILCAT_ENABLED=false
