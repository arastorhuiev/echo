# echo memory profile — Hetzner CX42 (16 GB, 8 vCPU). DEFAULT.
#
# These values also match the inline `${VAR:-default}` fallbacks in
# docker-compose.yml, so a bare `docker compose up -d` already runs this
# profile. Passing it explicitly is only needed to switch BACK from the
# 8 GB profile:
#
#     docker compose --env-file deploy/profiles/cx42-16g.env up -d
#
# See docs/RUNBOOK.md → "Memory profiles (16↔8 GB switch)".

# ── Per-container memory ceilings ──────────────────────────────────────
# Σ ≈ 10.0 GB, leaving ~6 GB host headroom on a 16 GB box.
POSTGRES_MEM_LIMIT=1536m
REDIS_MEM_LIMIT=768m
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=1024m
OSINT_PY_MEM_LIMIT=6144m

# ── Per-container CPU ceilings (max, not reservation) ──────────────────
POSTGRES_CPUS=2
REDIS_CPUS=1
API_CPUS=2
WORKER_CPUS=2
OSINT_PY_CPUS=4

# ── Heavy-provider concurrency (sidecar semaphores, app/concurrency.py) ─
# GLOBAL_HEAVY caps total concurrent heavy runs; MAIGRET is the greediest
# tool so it carries its own tighter cap. MAILCAT (headless Chromium,
# ~600 MB) is affordable here.
GLOBAL_HEAVY_CONCURRENCY=3
MAIGRET_MAX_CONCURRENCY=2
MAILCAT_ENABLED=true
