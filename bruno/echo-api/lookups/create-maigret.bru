meta {
  name: lookups - create (maigret)
  type: http
  seq: 14
}

post {
  url: {{apiBase}}/lookups
  body: json
  auth: none
}

body:json {
  {
    "providerId": "maigret",
    "query": {
      "username": "{{testUsername}}"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.streamUrl: matches ^/api/lookups/.+/stream$
}

vars:post-response {
  lookupId: res.body.id
}

docs {
  Hunts the username across maigret's ~3000-site corpus. Same event
  shape as Sherlock (Partial per found, Final with totals). Run side
  by side with Sherlock to dedupe overlapping results at the
  orchestration layer.
}
