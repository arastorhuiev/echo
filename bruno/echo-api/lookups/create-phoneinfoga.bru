meta {
  name: lookups - create (phoneinfoga)
  type: http
  seq: 6
}

post {
  url: {{apiBase}}/lookups
  body: json
  auth: none
}

body:json {
  {
    "providerId": "phoneinfoga",
    "query": {
      "phone": "{{testPhone}}"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.streamUrl: matches ^/api/lookups/.+/stream$
}

vars:post-response {
  lookupId: res.body.id
}

docs {
  Hits the in-container `phoneinfoga serve` REST API (started by the
  sidecar's FastAPI lifespan). Result is a Final with local-scanner
  metadata (country/dial code) plus ~10-30 Google dork URLs.
}
