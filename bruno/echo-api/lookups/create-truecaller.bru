meta {
  name: lookups - create (truecaller)
  type: http
  seq: 8
}

post {
  url: {{apiBase}}/lookups
  body: json
  auth: none
}

body:json {
  {
    "providerId": "truecaller",
    "query": {
      "phone": "{{testPhone}}",
      "country_code": "{{testPhoneCountryIso}}"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.streamUrl: matches ^/api/lookups/.+/stream$
}

vars:post-response {
  lookupId: res.body.id
}

docs {
  Env-conditional on TRUECALLER_INSTALLATION_ID. Without the env, the
  Final carries `configured: false` + an OWNER_TODO.md pointer. With
  it set, returns Truecaller's crowd-name + spam-score if known.

  Smoke-test the first time you set the env: if you see HTTP-401 errors
  in the Final, the installationId has been invalidated and you need to
  re-run the SMS login flow with a fresh disposable SIM.
}
