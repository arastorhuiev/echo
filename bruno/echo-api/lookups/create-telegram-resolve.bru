meta {
  name: lookups - create (telegram-resolve +44 UK)
  type: http
  seq: 7
}

post {
  url: {{apiBase}}/lookups
  body: json
  auth: none
}

body:json {
  {
    "providerId": "telegram-resolve",
    "query": {
      "phone": "+442079460958"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.streamUrl: matches ^/api/lookups/.+/stream$
}

vars:post-response {
  lookupId: res.body.id
}

docs {
  Env-conditional. Without TELEGRAM_API_ID / TELEGRAM_API_HASH /
  TELEGRAM_SESSION_PATH set, the Final's `configured: false` flag
  arrives with a "see RUNBOOK" error string — the lookup still
  completes cleanly. With creds set, returns a slim Telegram profile
  if the number is registered there.
}
