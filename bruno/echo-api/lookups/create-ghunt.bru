meta {
  name: lookups - create (ghunt)
  type: http
  seq: 13
}

post {
  url: {{apiBase}}/lookups
  body: json
  auth: none
}

body:json {
  {
    "providerId": "ghunt",
    "query": {
      "email": "{{testEmail}}"
    }
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.streamUrl: matches ^/api/lookups/.+/stream$
}

vars:post-response {
  lookupId: res.body.id
}

docs {
  Env-conditional on the one-time `ghunt login` having been run (no env
  var — just the creds file at /secrets/.malfrats/ghunt/creds.m).
  Without it, the Final carries `configured: false` + an OWNER_TODO.md
  pointer. With it present, returns the Google Maps reviews / profile
  picture / real name (where the target has a Google account).

  If the Final shows `configured: true` + a "ghunt exited 1" error
  pointing at cookies — re-run `ghunt login` to refresh the creds.m
  file.
}
