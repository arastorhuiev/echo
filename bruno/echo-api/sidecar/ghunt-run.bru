meta {
  name: sidecar - ghunt JSON (direct)
  type: http
  seq: 12
}

post {
  url: {{sidecarBase}}/providers/ghunt/run
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}"
  }
}

assert {
  res.status: eq 200
  res.body.configured: isBoolean
  res.body.found: isBoolean
}

docs {
  Env-conditional direct hit. Without the creds.m file present at
  /secrets/.malfrats/ghunt/creds.m (minted once via `ghunt login`),
  returns `configured: false`. With it, spawns `ghunt email <addr>
  --json <tmpfile>` as a subprocess and normalises the verbose JSON
  dump into a slim profile.
}
