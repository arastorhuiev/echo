meta {
  name: sidecar - phoneinfoga JSON (direct)
  type: http
  seq: 7
}

post {
  url: {{sidecarBase}}/providers/phoneinfoga/run
  body: json
  auth: none
}

body:json {
  {
    "phone": "{{testPhone}}"
  }
}

assert {
  res.status: eq 200
  res.body.local_scanner: isDefined
  res.body.google_dorks: isArray
}

docs {
  Direct hit to the sidecar's phoneinfoga REST-proxy runner. Returns
  sync JSON with `local_scanner` (country + dial code) and
  `google_dorks` (~10-30 ready-to-click search URLs). HTTP errors
  against the in-container `phoneinfoga serve` API land in `error`
  rather than 5xx.
}
