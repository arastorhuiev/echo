  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^24.0.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.22.0"
  }
}
